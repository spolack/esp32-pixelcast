--- a/wled00/ota_update.cpp
+++ b/wled00/ota_update.cpp
@@ -332,6 +332,13 @@ void handleOTAData(AsyncWebServerRequest *request, size_t index, uint8_t *data,
   if (index == 0) {
     if (!beginOTA(request, context)) return;
 
+    // esp32-pixelcast, the firmware in the other slot, carries no WLED
+    // metadata: recognise it by the project name in its app descriptor.
+    if (len >= 112 && data[0] == 0xE9 && memcmp(data + 80, "esp32-pixelcast", 16) == 0) {
+      DEBUG_PRINTLN(F("OTA: esp32-pixelcast"));
+      context->releaseCheckPassed = true;
+    }
+
     #ifdef SUPPORT_GZIPPED_OTA
     if (len >= 2 && data[0] == 0x1F && data[1] == 0x8B) {
       DEBUG_PRINTLN(F("OTA: gzipped firmware detected"));
diff --git a/wled00/pixelcast.cpp b/wled00/pixelcast.cpp
new file mode 100644
index 00000000..7084084f
--- /dev/null
+++ b/wled00/pixelcast.cpp
@@ -0,0 +1,65 @@
+/*
+ * WLED next to esp32-pixelcast (the Art-Net node firmware in the other app
+ * slot of the same flash layout).
+ *
+ * - Way back: POST /pixelcast (WLED's settings PIN applies), or click BOOT
+ *   (GPIO0) three times within 2 s: the other slot becomes the boot slot and
+ *   WLED restarts into it.
+ */
+#include "wled.h"
+
+#ifdef ARDUINO_ARCH_ESP32
+#include "esp_partition.h"
+#include "esp_ota_ops.h"
+
+static bool pxcwBackRequested = false;
+static unsigned long pxcwBackAt = 0;
+
+// esp32-pixelcast's "storage" partition (settings, handoff, diagnostics).
+static const esp_partition_t* pxcwStorage() {
+  static const esp_partition_t* part = nullptr;
+  if (!part) part = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "storage");
+  return part;
+}
+
+// Boots esp32-pixelcast: the other app slot (the one WLED's own update page
+// would write next).
+static void pxcwBack(const char* why) {
+  const esp_partition_t* other = esp_ota_get_next_update_partition(nullptr);
+  DEBUG_PRINTF_P(PSTR("pixelcast: switching back (%s)\n"), why);
+  if (other && esp_ota_set_boot_partition(other) == ESP_OK) {
+    delay(100);
+    ESP.restart();
+  }
+  DEBUG_PRINTLN(F("pixelcast: no bootable image in the other slot"));
+}
+
+// POST /pixelcast: switch after the reply went out.
+void pxcwRequestBack() {
+  pxcwBackRequested = true;
+  pxcwBackAt = millis() + 500;
+}
+
+void pxcwLoop() {
+
+  if (pxcwBackRequested && (long)(millis() - pxcwBackAt) >= 0) pxcwBack("requested");
+
+  // BOOT (GPIO0) clicked three times within 2 s.
+  static bool inited = false, last = true;
+  static unsigned long changed = 0, clicks[3] = {0, 0, 0};
+  if (!inited) { pinMode(0, INPUT_PULLUP); inited = true; }
+  bool now = digitalRead(0);
+  unsigned long t = millis();
+  if (now != last && t - changed > 30) {
+    changed = t;
+    last = now;
+    if (now) {  // released
+      clicks[0] = clicks[1]; clicks[1] = clicks[2]; clicks[2] = t;
+      if (clicks[0] && t - clicks[0] < 2000) pxcwBack("BOOT clicked three times");
+    }
+  }
+}
+#else
+void pxcwRequestBack() {}
+void pxcwLoop() {}
+#endif
diff --git a/wled00/wled.cpp b/wled00/wled.cpp
index d0816716..e01e54ac 100644
--- a/wled00/wled.cpp
+++ b/wled00/wled.cpp
@@ -58,6 +58,7 @@ void WLED::reset()
 
 void WLED::loop()
 {
+  pxcwLoop();   // esp32-pixelcast in the other slot: the way back
   static uint16_t      heapTime = 0;   // timestamp for heap check
   static uint8_t       heapDanger = 0; // counter for consecutive low-heap readings
 #ifdef WLED_DEBUG
diff --git a/wled00/wled_server.cpp b/wled00/wled_server.cpp
index 7fea7387..3063707e 100644
--- a/wled00/wled_server.cpp
+++ b/wled00/wled_server.cpp
@@ -476,6 +476,13 @@ void initServer()
   }, JSON_BUFFER_SIZE);
   server.addHandler(handler);
 
+  // esp32-pixelcast in the other slot: start it.
+  server.on("/pixelcast", HTTP_POST, [](AsyncWebServerRequest *request){
+    if (!correctPIN) { request->send(401, "text/plain", "PIN required"); return; }
+    request->send(200, "text/plain", "Starting esp32-pixelcast...");
+    pxcwRequestBack();
+  });
+
   server.on(F("/version"), HTTP_GET, [](AsyncWebServerRequest *request){
     request->send(200, FPSTR(CONTENT_TYPE_PLAIN), (String)VERSION);
   });
