diff --git a/esp32/main/pixelcast.cpp b/esp32/main/pixelcast.cpp
new file mode 100644
index 0000000..2919136
--- /dev/null
+++ b/esp32/main/pixelcast.cpp
@@ -0,0 +1,19 @@
+// MoonLight next to esp32-pixelcast (the Art-Net node firmware in the other app slot of the
+// same flash layout, https://github.com/spolack/esp32-pixelcast), on its board.
+//
+// - The board: the LED outputs go through a 74HCT245 whose output enable is GPIO 25,
+//   driven low from the start.
+#include "sdkconfig.h"
+
+#ifdef CONFIG_MM_PIXELCAST
+#include "driver/gpio.h"
+
+// The 74HCT245's output enable (active low): without it no LED output reaches the strips.
+static constexpr gpio_num_t kLedOutputEnable = GPIO_NUM_25;
+
+void pixelcastEarly() {
+    gpio_reset_pin(kLedOutputEnable);
+    gpio_set_direction(kLedOutputEnable, GPIO_MODE_OUTPUT);
+    gpio_set_level(kLedOutputEnable, 0);
+}
+#endif
diff --git a/esp32/partitions/pixelcast_4mb.csv b/esp32/partitions/pixelcast_4mb.csv
new file mode 100644
index 0000000..f4e198e
--- /dev/null
+++ b/esp32/partitions/pixelcast_4mb.csv
@@ -0,0 +1,13 @@
+# esp32-pixelcast's dual-boot table (WLED's 4 MB layout: two 1.5 MB app slots, a 940 KB
+# LittleFS labeled `spiffs`, then esp32-pixelcast's trial record and settings). MoonLight runs
+# from one app slot next to esp32-pixelcast in the other; the board keeps this table, MoonLight
+# must never replace it.
+#
+# Name,     Type, SubType,   Offset,   Size
+nvs,        data, nvs,       0x9000,   0x5000
+otadata,    data, ota,       0xe000,   0x2000
+app0,       app,  ota_0,     0x10000,  0x180000
+app1,       app,  ota_1,     0x190000, 0x180000
+spiffs,     data, spiffs,    0x310000, 0xEB000
+bootstate,  data, undefined, 0x3FB000, 0x1000
+storage,    data, undefined, 0x3FC000, 0x4000
diff --git a/esp32/sdkconfig.defaults.pixelcast b/esp32/sdkconfig.defaults.pixelcast
new file mode 100644
index 0000000..9372209
--- /dev/null
+++ b/esp32/sdkconfig.defaults.pixelcast
@@ -0,0 +1,58 @@
+# Classic ESP32 next to esp32-pixelcast (https://github.com/spolack/esp32-pixelcast): a 4 MB
+# board with a W5500 on SPI, MoonLight in one 1.5 MB app slot of esp32-pixelcast's table.
+# Layered onto sdkconfig.defaults (no .eth, no .moonbase-*). Everything below the table is
+# there to fit the slot (WiFi + Ethernet at -O2 is 1.83 MB, this 1.53 MB).
+
+CONFIG_MM_PIXELCAST=y
+CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
+CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/pixelcast_4mb.csv"
+CONFIG_MM_SD_CARD=n
+
+# Ethernet: the W5500 on SPI, no EMAC (its RMII pads carry LED outputs on this board).
+CONFIG_ETH_USE_ESP32_EMAC=n
+CONFIG_ETH_USE_SPI_ETHERNET=y
+# The SPI interrupt in IRAM: the W5500 is served while flash is busy (uploads).
+CONFIG_SPI_MASTER_ISR_IN_IRAM=y
+
+# Timing: 1 ms ticks (frame and lock waits, the HTTP server ticked from the render loop);
+# the network on core 0, away from the LED refill interrupt on core 1; room for an upload
+# next to a stream of universes.
+CONFIG_FREERTOS_HZ=1000
+CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
+CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
+CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
+CONFIG_LWIP_TCP_WND_DEFAULT=11520
+
+# Size.
+CONFIG_COMPILER_OPTIMIZATION_SIZE=y
+CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
+CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
+CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
+CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
+CONFIG_LWIP_IPV6=n
+CONFIG_MDNS_ENABLE_BROWSE=n
+CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
+
+# No HTTPS: updates and JSON fetches over plain HTTP only, firmware upload unchanged.
+CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
+CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
+CONFIG_ESP_TLS_CUSTOM_STACK=y
+CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
+CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
+CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
+# WPA3-Personal (SAE) uses P-256; the other curves served TLS.
+CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
+CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
+CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
+CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
+CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
+CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
+CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n
+
+# WiFi: WPA2 and WPA3-Personal stay; enterprise, OWE and SAE on the access point go.
+CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
+CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
+CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP=n
+CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
+CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
+CONFIG_ESP_WIFI_GMAC_SUPPORT=n
