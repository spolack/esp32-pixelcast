From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Polack <spolack+git@mailbox.org>
Date: Fri, 6 Nov 2026 03:12:10 +0100
Subject: [PATCH 1/6] W5500 SPI Ethernet on the classic ESP32

A classic ESP32 built with CONFIG_ETH_USE_ESP32_EMAC off and SPI Ethernet
on now gets the W5500 driver: the espressif/w5500 component is pulled for
the esp32 target too, the per-chip default PHY is the W5500, and the RMII
pads are no longer reported as taken by Ethernet (on such a board they are
free for LED outputs).

The W5500's receive task is pinned to the core that starts Ethernet, away
from the LED refill interrupt on the other.

Builds with the EMAC are unchanged.
---
 esp32/main/idf_component.yml          | 5 +++--
 src/platform/esp32/platform_config.h  | 9 ++++++---
 src/platform/esp32/platform_esp32.cpp | 1 +
 3 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/esp32/main/idf_component.yml b/esp32/main/idf_component.yml
index 144bb68..a8faf0f 100644
--- a/esp32/main/idf_component.yml
+++ b/esp32/main/idf_component.yml
@@ -20,7 +20,8 @@ dependencies:
     version: "^1.0.0"
     rules:
       - if: "target == esp32p4"
-  # W5500 external SPI Ethernet PHY+MAC for the ESP32-S3 boards (SE16, LightCrafter) and the C3.
+  # W5500 external SPI Ethernet PHY+MAC for the ESP32-S3 boards (SE16, LightCrafter), the C3, and
+  # classic ESP32 boards wired to a W5500 (built with CONFIG_ETH_USE_ESP32_EMAC off).
   # IDF v6 moved the per-PHY SPI drivers out of esp_eth core into managed components
   # (same migration as ip101 above); ethInit's W5500 path (platform_esp32.cpp, behind
   # MM_ETH_W5500 = SPI-eth enabled AND no internal EMAC) needs esp_eth_mac_new_w5500 /
@@ -30,7 +31,7 @@ dependencies:
   espressif/w5500:
     version: "^1.0.0"
     rules:
-      - if: "target in [esp32s3, esp32c3]"
+      - if: "target in [esp32, esp32s3, esp32c3]"
   # H.264 hardware encoder wrapper for the P4's encoder silicon (HLS streaming). Gated on
   # MM_HLS, not the target: a bare target rule would land it in every P4 image; the Kconfig
   # gate keeps it out wherever HLS is off. $CONFIG{NAME} syntax per the esp_wifi_remote note.
diff --git a/src/platform/esp32/platform_config.h b/src/platform/esp32/platform_config.h
index 887d09f..ef37e93 100644
--- a/src/platform/esp32/platform_config.h
+++ b/src/platform/esp32/platform_config.h
@@ -85,7 +85,8 @@ constexpr EthFixedPad ethFixedPads[] = {
     {"ethCrsDv", 28}, {"ethRxd0", 29}, {"ethRxd1", 30},
 };
 constexpr uint8_t ethFixedPadCount = 6;
-#elif defined(CONFIG_IDF_TARGET_ESP32)
+#elif defined(CONFIG_IDF_TARGET_ESP32) && defined(CONFIG_ETH_USE_ESP32_EMAC)
+// Only with the EMAC built in: a W5500 board leaves these pads to LED outputs and other uses.
 constexpr EthFixedPad ethFixedPads[] = {
     // Classic RMII: one pad choice per signal, so these are the pins rather than a default.
     {"ethTxEn", 21}, {"ethTxd0", 19}, {"ethTxd1", 22},
@@ -93,7 +94,8 @@ constexpr EthFixedPad ethFixedPads[] = {
 };
 constexpr uint8_t ethFixedPadCount = 6;
 #endif
-#if defined(CONFIG_IDF_TARGET_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32P4) || defined(CONFIG_IDF_TARGET_ESP32)
+#if defined(CONFIG_IDF_TARGET_ESP32S31) || defined(CONFIG_IDF_TARGET_ESP32P4) || \
+    (defined(CONFIG_IDF_TARGET_ESP32) && defined(CONFIG_ETH_USE_ESP32_EMAC))
 // Every ESP32 is Xtensa or RISC-V, so a third is an unfinished port rather than a configuration.
 #if !defined(__XTENSA__) && !defined(__riscv)
 #error "MoonLive ESP32 backend: unsupported ISA (expected Xtensa or RISC-V)"
@@ -252,7 +254,8 @@ constexpr EthPinConfig ethConfigDefault =
   : isEsp32S31  ? EthPinConfig{ /*phyType*/ ethYt8531, /*addr*/ -1, /*mdc*/ 5, /*mdio*/ 6,
                                 /*rst*/ 7, /*rmiiClk*/ -1, /*extIn*/ false,
                                 /*miso*/ -1, /*mosi*/ -1, /*sck*/ -1, /*cs*/ -1, /*irq*/ -1 }
-  : isEsp32S3   ? EthPinConfig{ /*phyType*/ ethW5500, /*addr*/ 1, /*mdc*/ -1, /*mdio*/ -1,
+    // A classic ESP32 built with SPI Ethernet and no EMAC has a W5500 too.
+  : (isEsp32S3 || hasEthW5500) ? EthPinConfig{ /*phyType*/ ethW5500, /*addr*/ 1, /*mdc*/ -1, /*mdio*/ -1,
                                 /*rst*/ -1, /*rmiiClk*/ -1, /*extIn*/ false,
                                 /*miso*/ -1, /*mosi*/ -1, /*sck*/ -1, /*cs*/ -1, /*irq*/ -1 }
     // Stated rather than unset: an unset pin reads as free in the map, hiding a clash with an LED lane.
diff --git a/src/platform/esp32/platform_esp32.cpp b/src/platform/esp32/platform_esp32.cpp
index c2da8aa..9f3e858 100644
--- a/src/platform/esp32/platform_esp32.cpp
+++ b/src/platform/esp32/platform_esp32.cpp
@@ -952,6 +952,7 @@ static bool ethInitSpi() {
     }
 
     eth_mac_config_t mac_config = ETH_MAC_DEFAULT_CONFIG();
+    mac_config.flags |= ETH_MAC_FLAG_PIN_TO_CORE;   // the receive task on this core, off the one the LED refill interrupt takes
     eth_phy_config_t phy_config = ETH_PHY_DEFAULT_CONFIG();
     phy_config.phy_addr = ethConfig_.phyAddr;
     phy_config.reset_gpio_num = ethConfig_.rstGpio;   // -1 if the module self-resets
