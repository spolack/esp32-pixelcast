From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Polack <spolack+git@mailbox.org>
Date: Fri, 6 Nov 2026 03:15:12 +0100
Subject: [PATCH 4/6] esp32-pixelcast in the other slot: the way back

POST /api/pixelcast, or BOOT (GPIO0) clicked three times within 2 s,
makes the other app slot the boot slot and restarts into esp32-pixelcast.
The firmware upload accepts esp32-pixelcast's image, recognised by the
project name in its app descriptor.

esp32-pixelcast starts MoonLight as "pending verify" (its bootloader has
app rollback), and MoonLight never marked an image valid: its first
restart went back. Once its modules are set up it now marks its slot
valid.
---
 esp32/main/pixelcast.cpp                  | 64 +++++++++++++++++++++++
 src/core/system/HttpServerModule.cpp      | 14 +++++
 src/main.cpp                              |  9 ++++
 src/platform/esp32/platform_esp32_ota.cpp | 11 +++-
 4 files changed, 97 insertions(+), 1 deletion(-)

diff --git a/esp32/main/pixelcast.cpp b/esp32/main/pixelcast.cpp
index 2919136..ad0be04 100644
--- a/esp32/main/pixelcast.cpp
+++ b/esp32/main/pixelcast.cpp
@@ -3,17 +3,81 @@
 //
 // - The board: the LED outputs go through a 74HCT245 whose output enable is GPIO 25,
 //   driven low from the start.
+// - Started by esp32-pixelcast, MoonLight boots "pending verify" (its bootloader has app
+//   rollback): once it has set up it marks itself valid, or its next restart would go back.
+// - Way back: POST /api/pixelcast, or click BOOT (GPIO0) three times within 2 s: the other
+//   slot becomes the boot slot and MoonLight restarts into it. The firmware upload accepts
+//   esp32-pixelcast's image (recognised by the project name in its app descriptor).
 #include "sdkconfig.h"
 
 #ifdef CONFIG_MM_PIXELCAST
+#include "core/system/FilesystemModule.h"
 #include "driver/gpio.h"
+#include "esp_ota_ops.h"
+#include "esp_system.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+#include <cstdio>
+#include <cstring>
 
 // The 74HCT245's output enable (active low): without it no LED output reaches the strips.
 static constexpr gpio_num_t kLedOutputEnable = GPIO_NUM_25;
+static constexpr gpio_num_t kBoot = GPIO_NUM_0;
 
 void pixelcastEarly() {
     gpio_reset_pin(kLedOutputEnable);
     gpio_set_direction(kLedOutputEnable, GPIO_MODE_OUTPUT);
     gpio_set_level(kLedOutputEnable, 0);
 }
+
+// Whether a descriptor's project name (32 bytes, maybe unterminated) is esp32-pixelcast's.
+bool pixelcastIsImage(const char* project) {
+    return std::strncmp(project, "esp32-pixelcast", 32) == 0;
+}
+
+// Boots esp32-pixelcast: the other app slot (the one MoonLight's own update would write next).
+void pixelcastBack(const char* why) {
+    const esp_partition_t* other = esp_ota_get_next_update_partition(nullptr);
+    std::printf("pixelcast: switching back (%s)\n", why);
+    mm::FilesystemModule::flushPending();
+    if (other && esp_ota_set_boot_partition(other) == ESP_OK) {
+        vTaskDelay(pdMS_TO_TICKS(100));
+        esp_restart();
+    }
+    std::printf("pixelcast: no bootable image in the other slot\n");
+}
+
+// BOOT (GPIO0) clicked three times within 2 s; polled, the pin has its own pull-up.
+static void bootWatch(void*) {
+    gpio_reset_pin(kBoot);
+    gpio_set_direction(kBoot, GPIO_MODE_INPUT);
+    gpio_set_pull_mode(kBoot, GPIO_PULLUP_ONLY);
+    bool last = true;
+    TickType_t changed = 0, clicks[3] = {0, 0, 0};
+    for (;;) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+        const bool now = gpio_get_level(kBoot) != 0;
+        const TickType_t t = xTaskGetTickCount();
+        if (now == last || t - changed < pdMS_TO_TICKS(30)) continue;
+        changed = t;
+        last = now;
+        if (!now) continue;  // pressed; count the release
+        clicks[0] = clicks[1];
+        clicks[1] = clicks[2];
+        clicks[2] = t;
+        if (clicks[0] && t - clicks[0] < pdMS_TO_TICKS(2000)) pixelcastBack("BOOT clicked three times");
+    }
+}
+
+// After the modules are set up.
+void pixelcastAfterSetup() {
+    esp_ota_img_states_t state;
+    if (esp_ota_get_state_partition(esp_ota_get_running_partition(), &state) == ESP_OK &&
+        state == ESP_OTA_IMG_PENDING_VERIFY) {
+        esp_ota_mark_app_valid_cancel_rollback();
+        std::printf("pixelcast: this slot confirmed\n");
+    }
+    xTaskCreate(bootWatch, "pxcBoot", 4096, nullptr, 1, nullptr);
+}
 #endif
