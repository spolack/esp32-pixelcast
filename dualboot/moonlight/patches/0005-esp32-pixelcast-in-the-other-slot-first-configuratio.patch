+void pixelcastAfterSetup(mm::Scheduler& scheduler);
 #endif
 
 #include <csignal>   // sig_atomic_t: the stop flag a signal handler writes
@@ -289,9 +291,12 @@ void mm_main(volatile std::sig_atomic_t& keepRunning, uint16_t httpPort) {
     // Only where an IP stack exists, which is what makes a network-less build supported: @xref{why-registration-order-matters}.
     if constexpr (mm::platform::hasNetwork) scheduler.addModule(httpServer);
 
+#ifdef CONFIG_MM_PIXELCAST
+    pixelcastBeforeSetup();   // next to esp32-pixelcast: esp32/main/pixelcast.cpp
+#endif
     scheduler.setup();
 #ifdef CONFIG_MM_PIXELCAST
-    pixelcastAfterSetup();   // next to esp32-pixelcast: esp32/main/pixelcast.cpp
+    pixelcastAfterSetup(scheduler);
 #endif
 
     uint32_t lights = layouts->totalLightCount();
