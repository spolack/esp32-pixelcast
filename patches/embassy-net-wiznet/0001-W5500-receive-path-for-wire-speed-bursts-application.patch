+/// esp32-pixelcast: reading the W5500's RX buffer in the background, so the
+/// frames already read are handled while the next chunk transfers. Only used
+/// for the socket 0 RX buffer; any other SPI access may come in between
+/// (the implementation then waits for the read first).
+pub trait BulkRead: embedded_hal_async::spi::ErrorType {
+    /// Starts reading `len` bytes from RX buffer address `ptr`. False if it
+    /// could not start (see [`Self::bulk_error`]).
+    fn bulk_start(&mut self, ptr: u16, len: usize) -> bool;
+    /// Waits for the read and copies its bytes into `dst` (the started length).
+    fn bulk_finish(&mut self, dst: &mut [u8]) -> Result<(), Self::Error>;
+    /// The error for a read that could not start.
+    fn bulk_error(&mut self) -> Self::Error;
+    /// The driver's receive buffer, taken once by [`new`] (so the
+    /// application can place it in a RAM region of its choice).
+    fn take_rx_buffer(&mut self) -> Option<&'static mut [u8; BULK]>;
+    /// Called with each received frame (Ethernet header on). True: the
+    /// application handled it and it does not go to the network stack.
+    fn rx_hook(&mut self, _frame: &[u8]) -> bool {
+        false
+    }
+}
