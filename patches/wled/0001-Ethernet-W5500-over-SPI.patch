diff --git a/wled00/network.cpp b/wled00/network.cpp
index ed75b893..832e66f0 100644
--- a/wled00/network.cpp
+++ b/wled00/network.cpp
@@ -176,8 +176,88 @@ const ethernet_settings ethernetBoards[] = {
     ETH_PHY_LAN8720,     // eth_type
     ETH_CLOCK_GPIO0_IN   // eth_clk_mode
   },
+
+  // WLED_ETH_W5500 (16) - W5500 over SPI (pins: wled_ethernet.h)
+  {
+    1,                   // eth_address
+    -1,                  // eth_power
+    -1,                  // eth_mdc (unused)
+    -1,                  // eth_mdio (unused)
+#ifdef CONFIG_ETH_SPI_ETHERNET_W5500
+    ETH_PHY_W5500,       // eth_type
+#else
+    ETH_PHY_LAN8720,     // placeholder: this core has no W5500 driver
+#endif
+    ETH_CLOCK_GPIO0_IN   // eth_clk_mode (unused)
+  },
 };
 
+unsigned ethernetPins(uint8_t type, int8_t pins[16]) {
+  unsigned n = 0;
+  if (type == WLED_ETH_NONE || type >= WLED_NUM_ETH_TYPES) return 0;
+  if (type == WLED_ETH_W5500) {
+    const int8_t spi[] = { WLED_W5500_SCLK, WLED_W5500_MISO, WLED_W5500_MOSI, WLED_W5500_CS, WLED_W5500_INT, WLED_W5500_RST, WLED_W5500_OE };
+    for (int8_t p : spi) if (p >= 0) pins[n++] = p;
+    return n;
+  }
+  for (unsigned p = 0; p < WLED_ETH_RSVD_PINS_COUNT; p++) pins[n++] = esp32_nonconfigurable_ethernet_pins[p].pin;
+  const ethernet_settings &es = ethernetBoards[type];
+  if (es.eth_power >= 0) pins[n++] = es.eth_power;
+  if (es.eth_mdc >= 0)   pins[n++] = es.eth_mdc;
+  if (es.eth_mdio >= 0)  pins[n++] = es.eth_mdio;
+  switch (es.eth_clk_mode) {
+    case ETH_CLOCK_GPIO0_IN:
+    case ETH_CLOCK_GPIO0_OUT:  pins[n++] = 0;  break;
+    case ETH_CLOCK_GPIO16_OUT: pins[n++] = 16; break;
+    case ETH_CLOCK_GPIO17_OUT: pins[n++] = 17; break;
+    default: break;
+  }
+  return n;
+}
+
+// The static address from the first WiFi entry (as WLED uses it for WiFi too).
+static void ethernetStaticConfig() {
+  // https://github.com/wled/WLED/issues/5247
+  if (multiWiFi.size() && multiWiFi[0].staticIP != IPAddress() && multiWiFi[0].staticGW != IPAddress()) {
+    ETH.config(multiWiFi[0].staticIP, multiWiFi[0].staticGW, multiWiFi[0].staticSN, dnsAddress);
+  } else {
+    ETH.config(INADDR_NONE, INADDR_NONE, INADDR_NONE);
+  }
+}
+
+// W5500 over SPI: its own pins instead of the RMII ones.
+static bool beginW5500() {
+#ifndef CONFIG_ETH_SPI_ETHERNET_W5500
+  DEBUG_PRINTLN(F("initE: this build has no W5500 driver (needs Arduino core 3)"));
+  return false;
+#else
+  managed_pin_type pins[7];
+  unsigned n = 0;
+  pins[n++] = { (int8_t)WLED_W5500_SCLK, true };
+  pins[n++] = { (int8_t)WLED_W5500_MISO, false };
+  pins[n++] = { (int8_t)WLED_W5500_MOSI, true };
+  pins[n++] = { (int8_t)WLED_W5500_CS,   true };
+  pins[n++] = { (int8_t)WLED_W5500_INT,  false };
+  if (WLED_W5500_RST >= 0) pins[n++] = { (int8_t)WLED_W5500_RST, true };
+  if (WLED_W5500_OE >= 0)  pins[n++] = { (int8_t)WLED_W5500_OE,  true };
+  if (!PinManager::allocateMultiplePins(pins, n, PinOwner::Ethernet)) {
+    DEBUG_PRINTLN(F("initE: Failed to allocate W5500 pins"));
+    return false;
+  }
+  if (WLED_W5500_OE >= 0) {
+    pinMode(WLED_W5500_OE, OUTPUT);
+    digitalWrite(WLED_W5500_OE, LOW);
+  }
+  SPI.begin(WLED_W5500_SCLK, WLED_W5500_MISO, WLED_W5500_MOSI);
+  if (!ETH.begin(ETH_PHY_W5500, 1, WLED_W5500_CS, WLED_W5500_INT, WLED_W5500_RST, SPI)) {
+    DEBUG_PRINTLN(F("initE: ETH.begin() failed (W5500)"));
+    for (unsigned i = 0; i < n; i++) PinManager::deallocatePin(pins[i].pin, PinOwner::Ethernet);
+    return false;
+  }
+  return true;
+#endif
+}
+
 // sanity checks for ethernet config table and WLED_ETH_DEFAULT
 static_assert((sizeof(ethernetBoards)/sizeof(ethernetBoards[0])) == WLED_NUM_ETH_TYPES, "WLED_NUM_ETH_TYPES does not match size of ethernetBoards[] table.");
 
@@ -211,6 +291,14 @@ bool initEthernet()
 
   DEBUG_PRINTF_P(PSTR("initE: Attempting ETH config: %d\n"), ethernetType);
 
+  if (ethernetType == WLED_ETH_W5500) {
+    if (!beginW5500()) return false;
+    ethernetStaticConfig();
+    successfullyConfiguredEthernet = true;
+    DEBUG_PRINTLN(F("initE: *** Ethernet successfully configured! ***"));
+    return true;
+  }
+
   // Ethernet initialization should only succeed once -- else reboot required
   ethernet_settings es = ethernetBoards[ethernetType];
   managed_pin_type pinsToAllocate[10] = {
@@ -294,12 +382,7 @@ bool initEthernet()
     return false;
   }
 
