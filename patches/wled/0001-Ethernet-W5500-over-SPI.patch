-    ETH.config(multiWiFi[0].staticIP, multiWiFi[0].staticGW, multiWiFi[0].staticSN, dnsAddress);
-  } else {
-    ETH.config(INADDR_NONE, INADDR_NONE, INADDR_NONE);
-  }
+  ethernetStaticConfig();
 
   successfullyConfiguredEthernet = true;
   DEBUG_PRINTLN(F("initE: *** Ethernet successfully configured! ***"));
diff --git a/wled00/wled_ethernet.h b/wled00/wled_ethernet.h
index 6b8f0ba5..2375abc1 100644
--- a/wled00/wled_ethernet.h
+++ b/wled00/wled_ethernet.h
@@ -28,6 +28,37 @@ typedef struct EthernetSettings {
 
 extern const ethernet_settings ethernetBoards[];
 
+// WLED_ETH_W5500: a W5500 over SPI instead of an RMII PHY. Needs a core with
+// the W5500 driver (CONFIG_ETH_SPI_ETHERNET_W5500: Arduino core 3 on the
+// ESP32). Pins as build flags; the defaults are VSPI plus CS and INT as on
+// the ArtnetNode-ESP32 carrier. WLED_W5500_OE: an active-low output enable
+// to drive low (e.g. a level shifter that also carries the LED outputs).
+#ifndef WLED_W5500_SCLK
+  #define WLED_W5500_SCLK 18
+#endif
+#ifndef WLED_W5500_MISO
+  #define WLED_W5500_MISO 19
+#endif
+#ifndef WLED_W5500_MOSI
+  #define WLED_W5500_MOSI 23
+#endif
+#ifndef WLED_W5500_CS
+  #define WLED_W5500_CS 5
+#endif
+#ifndef WLED_W5500_INT
+  #define WLED_W5500_INT 4
+#endif
+#ifndef WLED_W5500_RST
+  #define WLED_W5500_RST -1
+#endif
+#ifndef WLED_W5500_OE
+  #define WLED_W5500_OE -1
+#endif
+
+// The pins the given Ethernet board type uses (for reporting them as
+// reserved); returns how many it wrote to pins.
+unsigned ethernetPins(uint8_t type, int8_t pins[16]);
+
 #define WLED_ETH_RSVD_PINS_COUNT 6
 extern const managed_pin_type esp32_nonconfigurable_ethernet_pins[WLED_ETH_RSVD_PINS_COUNT];
 #endif
